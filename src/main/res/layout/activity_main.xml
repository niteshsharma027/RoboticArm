<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1C1C24"
    tools:ignore="HardcodedText,ContentDescription">

    <Button android:id="@+id/btn_lt" android:layout_width="70dp" android:layout_height="45dp" android:text="LT" android:textColor="#00FFFF" android:background="@drawable/btn_rounded_outline" app:backgroundTint="@null" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" android:layout_margin="24dp"/>
    <Button android:id="@+id/btn_lb" android:layout_width="70dp" android:layout_height="45dp" android:text="LB" android:textColor="#00FFFF" android:background="@drawable/btn_rounded_outline" app:backgroundTint="@null" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toEndOf="@id/btn_lt" android:layout_marginTop="24dp" android:layout_marginStart="16dp"/>

    <Button android:id="@+id/btn_rt" android:layout_width="70dp" android:layout_height="45dp" android:text="RT" android:textColor="#00FFFF" android:background="@drawable/btn_rounded_outline" app:backgroundTint="@null" app:layout_constraintTop_toTopOf="parent" app:layout_constraintEnd_toEndOf="parent" android:layout_margin="24dp"/>
    <Button android:id="@+id/btn_rb" android:layout_width="70dp" android:layout_height="45dp" android:text="RB" android:textColor="#00FFFF" android:background="@drawable/btn_rounded_outline" app:backgroundTint="@null" app:layout_constraintTop_toTopOf="parent" app:layout_constraintEnd_toStartOf="@id/btn_rt" android:layout_marginTop="24dp" android:layout_marginEnd="16dp"/>

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintVertical_bias="0.4" android:gravity="center">
        <ImageButton android:layout_width="50dp" android:layout_height="45dp" android:src="@android:drawable/ic_media_play" android:background="@drawable/btn_rounded_outline" app:tint="#00FFFF" android:layout_marginEnd="16dp"/>
        <ImageButton android:layout_width="55dp" android:layout_height="50dp" android:src="@android:drawable/ic_menu_add" android:background="@drawable/btn_rounded_outline" app:tint="#FF9800" android:layout_marginEnd="16dp"/>
        <ImageButton android:layout_width="50dp" android:layout_height="45dp" android:src="@android:drawable/ic_menu_revert" android:background="@drawable/btn_rounded_outline" app:tint="#00FFFF"/>
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:background="@drawable/dpad_ultra_3d"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="32dp"
        android:layout_marginBottom="32dp">

        <View android:id="@+id/dpad_center" android:layout_width="40dp" android:layout_height="40dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <TextView android:id="@+id/btn_up" android:layout_width="40dp" android:layout_height="40dp" android:text="△" android:textColor="#00FFFF" android:textSize="24sp" android:gravity="center" android:background="?android:attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true" app:layout_constraintBottom_toTopOf="@id/dpad_center" app:layout_constraintStart_toStartOf="@id/dpad_center" app:layout_constraintEnd_toEndOf="@id/dpad_center" />
        <TextView android:id="@+id/btn_down" android:layout_width="40dp" android:layout_height="40dp" android:text="▽" android:textColor="#00FFFF" android:textSize="24sp" android:gravity="center" android:background="?android:attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true" app:layout_constraintTop_toBottomOf="@id/dpad_center" app:layout_constraintStart_toStartOf="@id/dpad_center" app:layout_constraintEnd_toEndOf="@id/dpad_center" />
        <TextView android:id="@+id/btn_left" android:layout_width="40dp" android:layout_height="40dp" android:text="◁" android:textColor="#00FFFF" android:textSize="24sp" android:gravity="center" android:background="?android:attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true" app:layout_constraintEnd_toStartOf="@id/dpad_center" app:layout_constraintTop_toTopOf="@id/dpad_center" app:layout_constraintBottom_toBottomOf="@id/dpad_center" />
        <TextView android:id="@+id/btn_right" android:layout_width="40dp" android:layout_height="40dp" android:text="▷" android:textColor="#00FFFF" android:textSize="24sp" android:gravity="center" android:background="?android:attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true" app:layout_constraintStart_toEndOf="@id/dpad_center" app:layout_constraintTop_toTopOf="@id/dpad_center" app:layout_constraintBottom_toBottomOf="@id/dpad_center" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:background="@drawable/dpad_ultra_3d"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="32dp">

        <View android:id="@+id/xyab_center" android:layout_width="10dp" android:layout_height="10dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
        <TextView android:id="@+id/btn_y" android:layout_width="45dp" android:layout_height="45dp" android:text="Y" android:textColor="#00FFFF" android:textSize="20sp" android:textStyle="bold" android:gravity="center" android:background="@drawable/circle_solid" android:clickable="true" android:focusable="true" app:layout_constraintBottom_toTopOf="@id/xyab_center" app:layout_constraintStart_toStartOf="@id/xyab_center" app:layout_constraintEnd_toEndOf="@id/xyab_center" android:layout_marginBottom="4dp"/>
        <TextView android:id="@+id/btn_a" android:layout_width="45dp" android:layout_height="45dp" android:text="A" android:textColor="#4CAF50" android:textSize="20sp" android:textStyle="bold" android:gravity="center" android:background="@drawable/circle_solid" android:clickable="true" android:focusable="true" app:layout_constraintTop_toBottomOf="@id/xyab_center" app:layout_constraintStart_toStartOf="@id/xyab_center" app:layout_constraintEnd_toEndOf="@id/xyab_center" android:layout_marginTop="4dp"/>
        <TextView android:id="@+id/btn_x" android:layout_width="45dp" android:layout_height="45dp" android:text="X" android:textColor="#FFEB3B" android:textSize="20sp" android:textStyle="bold" android:gravity="center" android:background="@drawable/circle_solid" android:clickable="true" android:focusable="true" app:layout_constraintEnd_toStartOf="@id/xyab_center" app:layout_constraintTop_toTopOf="@id/xyab_center" app:layout_constraintBottom_toBottomOf="@id/xyab_center" android:layout_marginEnd="4dp"/>
        <TextView android:id="@+id/btn_b" android:layout_width="45dp" android:layout_height="45dp" android:text="B" android:textColor="#F44336" android:textSize="20sp" android:textStyle="bold" android:gravity="center" android:background="@drawable/circle_solid" android:clickable="true" android:focusable="true" app:layout_constraintStart_toEndOf="@id/xyab_center" app:layout_constraintTop_toTopOf="@id/xyab_center" app:layout_constraintBottom_toBottomOf="@id/xyab_center" android:layout_marginStart="4dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout android:id="@+id/left_joy_base" android:layout_width="80dp" android:layout_height="80dp" android:background="@drawable/circle_outline" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintHorizontal_bias="0.35" android:layout_marginBottom="24dp">
        <View android:id="@+id/left_joy_stick" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/circle_solid" android:layout_gravity="center"/>
    </FrameLayout>

    <FrameLayout android:id="@+id/right_joy_base" android:layout_width="80dp" android:layout_height="80dp" android:background="@drawable/circle_outline" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintHorizontal_bias="0.65" android:layout_marginBottom="24dp">
        <View android:id="@+id/right_joy_stick" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/circle_solid" android:layout_gravity="center"/>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>