<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:top="6dp" android:left="3dp" android:right="3dp">
        <shape android:shape="oval">
            <solid android:color="#050508"/>
        </shape>
    </item>

    <item android:bottom="4dp">
        <shape android:shape="oval">
            <gradient android:startColor="#4A4A5A" android:endColor="#1A1A24" android:angle="270"/>
        </shape>
    </item>

    <item android:bottom="6dp" android:top="4dp" android:left="4dp" android:right="4dp">
        <shape android:shape="oval">
            <gradient android:startColor="#0D0D14" android:endColor="#252530" android:angle="270"/>
            <stroke android:width="2dp" android:color="#00FFFF"/>
        </shape>
    </item>

    <item android:bottom="10dp" android:top="8dp" android:left="8dp" android:right="8dp">
        <shape android:shape="oval">
            <gradient android:startColor="#383848" android:endColor="#181825" android:angle="270"/>
            <stroke android:width="1dp" android:color="#2A2A38"/>
        </shape>
    </item>

</layer-list>